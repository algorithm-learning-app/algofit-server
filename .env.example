# algofit-server 환경변수 예시 — 복사해서 .env 로 사용
# 동기화 토큰 서명용 시크릿. 모바일 앱의 --dart-define=SYNC_SECRET 과 동일한 값이어야 한다.
# 충분히 긴 임의 문자열을 쓸 것: 예) openssl rand -hex 32
SYNC_SECRET=change-me-to-a-long-random-string

# 리슨 포트 / 호스트 (기본 8787 / 0.0.0.0)
PORT=8787
HOST=0.0.0.0

# SQLite 파일 경로 (기본 ./data/progress.db). 영속 디스크에 둘 것.
DB_PATH=./data/progress.db
